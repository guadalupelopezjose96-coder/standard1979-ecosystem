<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"\>
<plist version="1.0">
<dict>
    <!-- 1. Cero Rastreo Publicitario de Terceros (Elimina requisito de banner ATT) -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- 2. Tipos de Datos Recopilados con Vinculación a Identidad B2B Funcional -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Credenciales de Autenticación / Correo Corporativo -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Identificador de Usuario Único en Plataforma -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Registros de Diagnóstico y Telemetría de Errores eBPF/Crash -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>

    <!-- 3. Declaración de Motivos Válidos para APIs de Uso Restringido (Required Reason APIs) -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- Acceso a UserDefaults para Caché de Configuración Local y Tokens de Sesión -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Acceso a UserDefaults de la propia app para almacenar preferencias funcionales -->
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- Marcas de Tiempo del Sistema para Sincronización Notarial Merkle/PQC -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 35F9.1: Medición de intervalos de tiempo absolutos para eventos de sesión y criptografía -->
                <string>35F9.1</string>
            </array>
        </dict>
        <!-- Espacio en Disco para Almacenamiento Local Seguro de Manifiestos -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- E174.1: Comprobación de espacio disponible antes de descargar modelos o artefactos -->
                <string>E174.1</string>
            </array>
        </dict>
        <!-- Metadatos de Archivo para Verificación de Checksums Locales -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- C617.1: Consulta de fechas de modificación para validar expiración de caché local -->
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
